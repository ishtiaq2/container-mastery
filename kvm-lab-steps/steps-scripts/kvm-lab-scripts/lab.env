# shellcheck shell=bash
# lab.env - settings and a few helpers used by every script.
# The scripts load this file themselves. To type commands by hand:  source ./lab.env

LAB_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # the folder this file is in
export LAB_HOME
export LAB_POOL="lab-pool"
export LAB_POOL_DIR="/var/lib/libvirt/images/kvm-lab"
export LAB_BASE_DIR="$LAB_POOL_DIR/base"
export LAB_NET="lab-nat"
export LAB_SUBNET="192.168.150"
export LAB_BRIDGE="br-lab"
export LAB_USER="lab"
export LAB_SSH_KEY="$LAB_HOME/ssh/id_ed25519"
export LIBVIRT_DEFAULT_URI="qemu:///system"
export REMOTE="${REMOTE:-}"          # only for step 15, e.g.  export REMOTE=student@192.168.10.50

# ssh / scp into lab VMs with the lab key (VM IPs get reused, so no known_hosts entries)
labssh() { ssh -i "$LAB_SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$@"; }
labscp() { scp -i "$LAB_SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$@"; }

# vm_ip VM : print the VM's IPv4 address (DHCP lease on lab-nat, otherwise ask the guest agent)
vm_ip() {
  local ip
  ip=$(virsh domifaddr "$1" 2>/dev/null | awk '/ipv4/{sub(/\/.*/,"",$4); print $4; exit}') || true
  if [ -z "$ip" ]; then
    ip=$(virsh domifaddr "$1" --source agent 2>/dev/null | awk '/ipv4/ && $1 !~ /^(lo|docker|br-|veth)/ {sub(/\/.*/,"",$4); print $4; exit}') || true
  fi
  echo "$ip"
}

# wait_ip VM : wait up to 5 minutes for an IP, then print it
wait_ip() {
  local ip
  for _ in $(seq 1 60); do
    ip=$(vm_ip "$1")
    if [ -n "$ip" ]; then echo "$ip"; return 0; fi
    sleep 5
  done
  return 1
}

# vm_stop VM : polite shutdown, force off after 60 s
vm_stop() {
  virsh shutdown "$1" >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do
    if [ "$(virsh domstate "$1" 2>/dev/null)" = "shut off" ]; then return 0; fi
    sleep 2
  done
  virsh destroy "$1" >/dev/null 2>&1 || true
}
